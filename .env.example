# Copy to .env for local development. Never commit .env or real secrets.
# In production (Render), set these in the service's Environment tab instead.

# --- Django ---
DEBUG=True
# Required to be a real random value when DEBUG=False (startup fails otherwise).
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=django-insecure-fraudguard-dev-secret-key-change-in-production
# Comma-separated. On Render: fraudguard.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Needed for the Django admin over HTTPS, e.g. https://fraudguard.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave empty to use SQLite for development/testing.
# Neon gives two URLs for the same database (`neon env pull` writes both):
#   DATABASE_URL           pooled, host ends in -pooler: used for app traffic
#   DATABASE_URL_UNPOOLED  direct: used automatically by migrate/makemigrations/dbshell/tests
# postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require
# Query params (sslmode etc.) are passed through to the Postgres driver.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Seconds to keep DB connections open (0 = close after each request)
DB_CONN_MAX_AGE=60

# --- Redis (Celery broker + result backend, Channels layer, velocity counters) ---
# Upstash: rediss://default:PASSWORD@xxxx.upstash.io:6379  (rediss:// = TLS, required by Upstash)
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
# True runs scoring inline in the web process (dev/tests only, no worker needed).
# Must be False in deployment so ingestion never blocks on scoring.
CELERY_TASK_ALWAYS_EAGER=True
# Worker processes started by start.sh. Keep at 1 on Render free (512 MB RAM).
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# --- Channels ---
# Set to "inmemory" to skip Redis for WebSockets (single process only)
CHANNEL_LAYERS_BACKEND=

# --- Scoring ---
RISK_SCORE_ALERT_THRESHOLD=0.6
INGESTION_THROTTLE_RATE=100/minute
# Defaults to risk/ml_models/isolation_forest.joblib. Leave commented out:
# an empty value disables the ML scorer.
# ML_MODEL_PATH=

# --- Server ---
# Render injects PORT automatically; start.sh defaults to 8000
PORT=8000

# --- Demo tools ---
# Password for the demo logins created by `manage.py seed_demo`
# (maya.chen / dev.patel = analyst, ops.admin = admin, ingest-gateway = ingestion client).
# Local test value only; change it on any deployed demo.
DEMO_PASSWORD=fraudguard-demo
# Enables the dashboard's "Simulate traffic" button (POST /api/demo/simulate/). Defaults to DEBUG.
DEMO_TOOLS_ENABLED=

# --- Running locally with no Redis server ---
# REDIS_URL=fakeredis://
# CHANNEL_LAYERS_BACKEND=inmemory
# CELERY_TASK_ALWAYS_EAGER=True
